{"id":1750939,"retrievedAt":"2026-08-17T11:48:00.809Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"https://zasoby.msl.org.pl/arts/view/20593?&page_art_mcol=2","id":1750939,"imdb_id":null,"origin_country":["PL"],"original_language":"pl","original_title":"Koreks","overview":"The ‘koreks’ of the title refers to a film developing tank. The work depicts an undeveloped roll of film, supposedly found years later in a cellar. Sasnal uses this motif as a starting point for a story about memory and family genealogy. The film features the artist’s father and son, whilst his own presence is replaced by images that interact with people and objects. *Koreks* does not reconstruct a single story, but builds tension between what has been preserved and what has been lost or is merely imagined.","popularity":0.0071,"poster_path":"/j9N8pV2A7cXQBK7DxJ81IPEphGN.jpg","production_companies":[],"production_countries":[],"release_date":"","revenue":0,"runtime":15,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"Developing Tank","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":2,"id":1073827,"known_for_department":"Directing","name":"Wilhelm Sasnal","original_name":"Wilhelm Sasnal","popularity":0.4147,"profile_path":null,"credit_id":"6a8223ab2167c6357a9578a1","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":null,"wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"images":{"backdrops":[],"logos":[],"posters":[{"aspect_ratio":0.666,"height":848,"iso_3166_1":null,"iso_639_1":null,"file_path":"/j9N8pV2A7cXQBK7DxJ81IPEphGN.jpg","vote_average":0,"vote_count":0,"width":565}]},"keywords":{"keywords":[]},"release_dates":{"results":[]},"videos":{"results":[]}}}