{"id":1750882,"retrievedAt":"2026-08-17T11:47:57.008Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"},{"id":10770,"name":"TV Movie"}],"homepage":"https://www.mntnfilm.com/en/film/men-against-the-matterhorn-1965","id":1750882,"imdb_id":null,"origin_country":["GB"],"original_language":"en","original_title":"Men Against the Matterhorn","overview":"A climb to mark the 100th anniversary of the first ascent of the Matterhorn, live on TV. The program, a co-production of the Swiss, French, Italian and British televisions, was shown throughout Europe, in the United States and in Japan in a series of 5 broadcasts between 8 and 16h. This film is the re-edited version by the BBC of all the broadcasts in a single program. Ian McNaught-Davis roped with the guide Heinrich Taugwalder and Jean Juge with Robert Bichler narrate the ascent while they climb by the original Whymper route. They follow the progression of Michel Darbellay and Hilti von Allmen who climb the north face by the Schmidt route. All them meet at the summit.","popularity":0.0071,"poster_path":"/xJpIf8DcrXkbKOqRW9nzttzyEL7.jpg","production_companies":[{"id":285865,"logo_path":null,"name":"SRF","origin_country":""},{"id":3324,"logo_path":"/dqT3yOTlfJRmtvk52Ccd1O6dZ0A.png","name":"BBC","origin_country":"GB"}],"production_countries":[{"iso_3166_1":"GB","name":"United Kingdom"}],"release_date":"1965-01-01","revenue":0,"runtime":50,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Men Against the Matterhorn","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"GB","title":"Live Eurovision Transmission of Matterhorn Centenary Ascent","type":""}]},"credits":{"cast":[{"adult":false,"gender":0,"id":3991537,"known_for_department":"Acting","name":"Ian McNaught-Davis","original_name":"Ian McNaught-Davis","popularity":0.