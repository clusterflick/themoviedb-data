{"id":1802109,"retrievedAt":"2026-10-20T16:01:55.356Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":16,"name":"Animation"}],"homepage":"","id":1802109,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"Trapped","overview":"An animation for Insmed bringing awareness to the rare lung disease NTM. People suffering from NTM aren’t being diagnosed by their doctors. To get doctors to understand the impact undiagnosed NTM has on patients’ lives, Insmed paired real NTM patients with animators to create original films that communicate how hard it is for patients to live without a diagnosis. Trapped is the reimagination of Beth’s story using stop-motion animation. Prior to being diagnosed, Beth’s repetitive symptoms made her feel like she couldn’t escape from NTM. She felt imprisoned in a monstrous contraption that made her cough constantly, and feel fatigued and feverish.","popularity":0.0143,"poster_path":null,"production_companies":[{"id":109769,"logo_path":"/unlsZeKmpnCukuZtMX2oqLyLNRO.png","name":"Passion Animation Studios","origin_country":"GB"}],"production_countries":[],"release_date":"2021-09-14","revenue":0,"runtime":2,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Trapped","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":1,"id":1273315,"known_for_department":"Directing","name":"Anna Mantzaris","original_name":"Anna Mantzaris","popularity":0.5227,"profile_path":"/fvY7AZF2r9pH0j34sCvltAXT8Uw.jpg","credit_id":"6ad6916bb54507e244cebee5","department":"Directing","job":"Director"},{"adult":false,"gender":0,"id":2503280,"known_for_department":"Camera","name":"Donna Wade","original_name":"Donna Wade","popularity":0.3629,"profile_path":null,"credit_id":"6ad69187dea0824ca8be0e16","department":"Camera","job":"Dir