{"id":1758402,"retrievedAt":"2026-08-30T15:36:39.751Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://alexanderryneus.se/the-glitter-factory","id":1758402,"imdb_id":"tt27030348","origin_country":["SE"],"original_language":"sv","original_title":"Glitterfabriken","overview":"Between 1950 and 1970, Sweden’s only tinsel factory was located in a house near Västansjö in Dalarna. The factory embodied the cycles of the year: Christmas tree tinsel in winter, binoculars in spring, sunglasses in summer, and zippers in autumn. After the factory closed, it became the home of director Alexander Rynéus’s grandparents—who have since passed away. Together with his parents, he sorts through the factory’s old artifacts, transforming the house into an archaeological dig.","popularity":0.0071,"poster_path":"/g22syCWPcV1uqOdx6O3alo8ofYh.jpg","production_companies":[],"production_countries":[{"iso_3166_1":"SE","name":"Sweden"}],"release_date":"","revenue":0,"runtime":51,"softcore":false,"spoken_languages":[{"english_name":"Swedish","iso_639_1":"sv","name":"svenska"}],"status":"Released","tagline":"","title":"Glitterfabriken","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6444319,"known_for_department":"Acting","name":"Barbro Rynéus","original_name":"Barbro Rynéus","popularity":0,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6a9338c56a7166f6b2424d8b","order":0},{"adult":false,"gender":0,"id":6444322,"known_for_department":"Acting","name":"Torbjörn Rynéus","original_name":"Torbjörn Rynéus","popularity":0,"profile_path":null,"cast_id":2,"character":"Self","credit_id":"6a9338dccdc6a9c1a7bdbed7","order":1}],"crew":[{"adult":false,"gender":0,"id":2013489,"known_for_department":"Directing","name":"Alexander Rynéus","original_name":"Alexander Rynéus","popularity":0.282,"profile_path":null,"credit