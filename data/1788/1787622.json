{"id":1787622,"retrievedAt":"2026-10-04T15:56:11.201Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1787622,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"Bed Piece","overview":"For the 22 days between February 18th to March 10th, 1972 at Market Street Program in Venice Beach, California, Chris Burden performed his Bed Piece. After stripping down to his underwear, the artist climbed into a bed placed on the gallery floor and remained there for the extent of the performance. Throughout the 22 days he didn’t speak to anyone. Aside from the gazes of spectators, the only human interaction Burden received was when gallery staff provided him with water, food and toilet facilities.","popularity":0.0071,"poster_path":null,"production_companies":[],"production_countries":[],"release_date":"1972-01-01","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"Bed Piece","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":2,"id":1487575,"known_for_department":"Directing","name":"Chris Burden","original_name":"Chris Burden","popularity":0.5246,"profile_path":"/xidE87HxspWH9dtklyuhFCS6U2T.jpg","credit_id":"6ac11efe470fe4c3b8fdae62","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":null,"wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"images":{"backdrops":[],"logos":[],"posters":[]},"keywords":{"keywords":[]},"release_dates":{"results":[{"iso_3166_1":"US","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"1972-01-01T00:00:00.000Z","type":6}]}]},"videos":{"results":[]}}}