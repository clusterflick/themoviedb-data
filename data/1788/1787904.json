{"id":1787904,"retrievedAt":"2026-10-04T15:56:33.210Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1787904,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"Century of Enslavement: The History of the Federal Reserve","overview":"Century of Enslavement: The History of the Federal Reserve exposes the secretive origins and global impact of the United States central banking system. Directed by investigative journalist James Corbett, the documentary traces the history of the Federal Reserve from its clandestine inception at a private Jekyll Island meeting in 1910 to its passage into law in 1913. Through historical analysis and economic commentary, the film argues that the Fed operates as a private banking cartel designed to manipulate markets, generate artificial economic cycles, and systematically erode the purchasing power of the American dollar. Ultimately, it examines how the mechanics of debt-based fiat currency shape modern wealth inequality and corporate state control.","popularity":0,"poster_path":"/eXh5PhFVROYuqePRiwWfIlQo4yj.jpg","production_companies":[{"id":26887,"logo_path":null,"name":"The Corbett Report","origin_country":""}],"production_countries":[],"release_date":"2014-07-06","revenue":0,"runtime":90,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"The truth behind the money you carry and the debt you owe.","title":"Century of Enslavement: The History of the Federal Reserve","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":2,"id":1338681,"known_for_department":"Acting","name":"James Corbett","original_name":"James Corbett","popularity":0.3825,"profile_path":null,"cast_id":4,"character":"Narrator / Himself","credit_id":"6ac1a29796a4ba31165ace99","order":0},{"adult":false,"gender":2,"id":590474,"known_for_department":"Acting","