{"id":1740030,"retrievedAt":"2026-07-30T12:50:04.328Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1740030,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"ᎠᏲᎧ","overview":"ᎠᏲᎧ is a portrait of Ahyoka Youngdeer, Cherokee culture bearer, teacher, and two-spirit activist. Through her own life story, woven together with a traditional Cherokee story about crooked-faced children left in the woods and their return to community, Ahyoka traces how exclusion from school, family, and her own people, was never written into Cherokee values. It was imported. An elder's story reveals what was always true: she was never the problem. Through her journey, ᎠᏲᎧ reminds Cherokee people that Keetoowah is a lifeway. And we must live it.","popularity":0.0071,"poster_path":null,"production_companies":[{"id":305895,"logo_path":null,"name":"Gwanagisgi Productions","origin_country":""}],"production_countries":[],"release_date":"","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Post Production","tagline":"A life. A teaching. A medicine.","title":"Ahyoka","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"US","title":"Ahyoka","type":"English"}]},"credits":{"cast":[{"adult":false,"gender":0,"id":6377954,"known_for_department":"Acting","name":"Ahyoka Youngdeer","original_name":"Ahyoka Youngdeer","popularity":0,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6a6a44526bf4deaac236bfba","order":0},{"adult":false,"gender":3,"id":3981119,"known_for_department":"Directing","name":"Schon Duncan","original_name":"Schon Duncan","popularity":0.096,"profile_path":"/tQOzwl2jAl37bBUtRIVc0rrKyLz.jpg","cast_id":10,"character":"Self","credit_id":"6a6a916f673eb11aa99a31ee","order":1}],"crew":[{"adult":false,"gender":3,"id":3981119,"known_f