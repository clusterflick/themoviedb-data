{"id":1821872,"retrievedAt":"2026-11-09T21:41:12.583Z","response":{"adult":false,"backdrop_path":"/20MVtElim7ze3bx0LIRrIrBJBXi.jpg","belongs_to_collection":null,"budget":0,"genres":[],"homepage":"","id":1821872,"imdb_id":null,"origin_country":["KR"],"original_language":"en","original_title":"한국농촌생활","overview":"A Korean promotional film produced in 1948 by the United States Information Service in Korea, directed by Lee Han-geun (李漢根), a Korean-American lieutenant in the U.S. Army.  It is the only surviving film produced during the period immediately following the establishment of the Republic of Korea, when public information responsibilities were being transferred from the Public Information Office of the U.S. Army Forces in Korea to the United States Information Service in Korea, and the organisation's operations were being restructured.  The film not only provides a valuable record of rural Korean life in the 1940s but is also one of the very few surviving visual records documenting traditional Korean farmers' music and dance (nongak), Hwarang Changgeuk (화랑창극), and the general outline of a dance adaptation of Chunhyangjeon (춘향전), performed by the married couple Jo Taek-won and Kim So-young.","popularity":0,"poster_path":"/iYpMksWWxZrdnOKICPUMsfLrZYy.jpg","production_companies":[{"id":317436,"logo_path":null,"name":"미국공보원 (USIS)","origin_country":""}],"production_countries":[{"iso_3166_1":"KR","name":"South Korea"}],"release_date":"","revenue":0,"runtime":15,"softcore":false,"spoken_languages":[{"english_name":"Korean","iso_639_1":"ko","name":"한국어/조선말"}],"status":"Released","tagline":"","title":"Korean Farm Life","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"US","title":"Korean Farm Life","type":"English"}]},"credits":{"cast":[{"adult":false,"gender":1,"id":1556170,"known_for_department":"Acting","name":"Kim Shin-jae","original_name":"김신재","popularity":0.3379,"profile_path":"/1sqGZmQncDFIwNMHrpovzm8eP0n.jpg","cast_id"