{"id":1765930,"retrievedAt":"2026-09-08T15:18:40.162Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1765930,"imdb_id":"tt0951240","origin_country":["US"],"original_language":"en","original_title":"In Surabaya, the 'Busy Burg' of Java","overview":"Surabaya, Java, is the busiest headquarters of the Dutch in the Far East. Here the white-clothed man from Holland has established the commercial metropolis of the Dutch East Indies. Here one sees evidence of \"big business\" and also finds satisfaction in traveling around the other parts of the town where evidence of \"small business,\" done in a large way, may be seen. Among the inhabitants of this busy little town are many Chinese, who are considered to be the thrifty men of the Far East. Many other wonderful sights in this quaint and picturesque little town await your patrons.","popularity":0,"poster_path":null,"production_companies":[{"id":95953,"logo_path":null,"name":"Burton Holmes Travel Pictures","origin_country":"US"}],"production_countries":[{"iso_3166_1":"US","name":"United States of America"}],"release_date":"1917-06-04","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"","title":"In Surabaya, the 'Busy Burg' of Java","video":false,"vote_average":0,"vote_count":0,"credits":{"cast":[],"crew":[{"adult":false,"gender":0,"id":2400469,"known_for_department":"Directing","name":"Burton Holmes","original_name":"Burton Holmes","popularity":0.3715,"profile_path":null,"credit_id":"6a9f6bcd04a07bec244b5e18","department":"Production","job":"Producer"}]},"external_ids":{"imdb_id":"tt0951240","wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"alternative_titles":{"titles":[{"iso_3166_1":"US","title":"Surbaya, the Busy Burg of Java","type":""}]},"images":{"backdrops":[],"logos":[],"posters"