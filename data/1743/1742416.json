{"id":1742416,"retrievedAt":"2026-08-04T13:23:12.746Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"","id":1742416,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"Vinalhaven","overview":"Thirteen Miles out in Maine's Penobscott Bay is the island of Vinalhaven. Once famous for granite, today Vinalhaven is a community of lobstering. It is a place people fall in love with, and if they aren't lucky enough to live there year round, it is a place they get to as often as they can. Once charmed by Vinalhaven's spell, there is no letting go. The only cure is to be there. In this loving portrait of Vinalhaven you will meet some of the people who call this island home. You will learn a little history and hear some island lore. You will take a trip on a lobster boat and visit with a world famous artist. But beware, you may want to move to an island - and island called Vinalhaven.","popularity":0.0071,"poster_path":null,"production_companies":[{"id":306317,"logo_path":null,"name":"Accompany","origin_country":""}],"production_countries":[],"release_date":"1996-08-14","revenue":0,"runtime":42,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"Vinalhaven","video":true,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":0,"id":6387820,"known_for_department":"Sound","name":"Tiger Okoshi","original_name":"Tiger Okoshi","popularity":0,"profile_path":null,"credit_id":"6a709778d8987b3a4ce3e9e3","department":"Sound","job":"Music"},{"adult":false,"gender":0,"id":6387821,"known_for_department":"Camera","name":"Lora Lovejoy","original_name":"Lora Lovejoy","popularity":0,"profile_path":null,"credit_id":"6a70978afddff647635da1d9","department":"Camera","job":"Still Photographer"},{"adult":false,"gender":0,"id":6387823,"known_for_department":"Production","name":"Accompany","original_name":"Accompany",