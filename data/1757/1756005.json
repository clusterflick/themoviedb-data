{"id":1756005,"retrievedAt":"2026-08-26T11:50:02.266Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":18,"name":"Drama"}],"homepage":"","id":1756005,"imdb_id":"tt0293315","origin_country":["JP"],"original_language":"ja","original_title":"ケメ子の唄","overview":"Kemeko (Rumi Koyama), a girl who loves go-go dancing, one day encounters two men who are about to commit suicide. They are Rokuzo (Kanichi Tani), a bankrupt real estate agent, and Kyosuke (Keizo Kawasaki), a former ballet teacher. Unable to carry out their suicides because Kemeko is in the way, the two men reluctantly go with Kemeko to Kyosuke's ballet studio. When Kemeko starts dancing with the band led by Susumu (Haruo Suzuki) who are practicing there, Kyosuke recognizes her talent and decides to make her a big star. Of course, Rokuzo, who has given up on suicide, also volunteers to help promote her. A few days later, Kemeko enters a go-go competition on television and wins. Kemeko was delighted to hear that the winner would get to go to Africa.","popularity":0.0214,"poster_path":"/ybRjf5APxF2puHQA003RrHWnljY.jpg","production_companies":[{"id":278951,"logo_path":null,"name":"Shochiku","origin_country":""}],"production_countries":[{"iso_3166_1":"JP","name":"Japan"}],"release_date":"1968-03-16","revenue":0,"runtime":84,"softcore":false,"spoken_languages":[{"english_name":"Japanese","iso_639_1":"ja","name":"日本語"}],"status":"Released","tagline":"","title":"Kemeko's Song","video":false,"vote_average":0,"vote_count":0,"external_ids":{"imdb_id":"tt0293315","wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"credits":{"cast":[{"adult":false,"gender":1,"id":1736130,"known_for_department":"Acting","name":"Rumi Koyama","original_name":"小山ルミ","popularity":0.6974,"profile_path":"/txUomql1VOwn0aKxZeShAGVYC3c.jpg","cast_id":2,"character":"Kemeko","credit_id":"6a8d9b3062d020ce189f94c0","order":0},{"adult":false,"gender":2,"id":1334095,"known_for_d