{"id":1745226,"retrievedAt":"2026-08-08T11:49:11.046Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"https://www.screenaustralia.gov.au/screen-guide/frankies-story-23196/","id":1745226,"imdb_id":null,"origin_country":["AU"],"original_language":"en","original_title":"Frankie's Story","overview":"\"Some things that happen when you're a child mark you for life,\" says forty-year old Frankie. He remembers the day he was prevented from attending a school excursion. Not permitted to join his classmates on their trip to the fire station, young Frankie coaxes fire engines to come to him, one hot summer's day many years ago. Told as flashback, FRANKIE'S STORY portrays a child's confusion and humiliation in the face of discrimination he's too young to understand. Frankie's poignant loss of innocence raises universal issues of social justice.","popularity":0.0071,"poster_path":null,"production_companies":[],"production_countries":[],"release_date":"2006-01-01","revenue":0,"runtime":7,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Frankie's Story","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":2,"id":1222753,"known_for_department":"Acting","name":"David Ngoombujarra","original_name":"David Ngoombujarra","popularity":0.5984,"profile_path":"/2eZfkt5cyyGesuwj32aZXaaRzqb.jpg","credit_id":"6a75e7ab9dd8a49fe618f13a","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":null,"wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"images":{"backdrops":[],"logos":[],"posters":[]},"keywords":{"keywords":[]},"release_dates":{"results":[{"iso_3166_1":"AU","release_dates":[{"certification":"","descriptors":[],"iso_639_1":"","note":"","release_date":"2006-01-01T00:00:00.000Z","type":3}]}]},"videos":{"results":[]