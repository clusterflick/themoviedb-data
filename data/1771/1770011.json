{"id":1770011,"retrievedAt":"2026-09-14T17:09:57.190Z","response":{"adult":false,"backdrop_path":"/vczFHTsEqKug0ILy3EcGapKPI2d.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1770011,"imdb_id":null,"origin_country":["UY"],"original_language":"es","original_title":"Caminar y dibujar al mismo tiempo","overview":"The artist Francisco Cunha uses a wooden device that hangs from his body to alter the usual conditions of drawing. He imposes a rule: to draw while walking, without stopping. His practice resembles a playful and performative act, since there is a set of self-imposed conditions that guide the action, but whose outcome remains open and unpredictable. Walking through the city introduces chance as part of the process. Every corner, object, or person that appears along the way becomes a stimulus to be recorded immediately. Therefore, the sheet of paper ceases to correspond to a pre-planned composition and begins to function as a surface of accumulation in motion.","popularity":0.0071,"poster_path":"/jk8oFdohTmbidP85cjYHAElA51w.jpg","production_companies":[],"production_countries":[],"release_date":"2024-06-01","revenue":0,"runtime":3,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"","title":"Caminar y dibujar al mismo tiempo","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6476541,"known_for_department":"Acting","name":"Francisco Cunha","original_name":"Francisco Cunha","popularity":0,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6aa713e53c5f516c15cba440","order":0}],"crew":[{"adult":false,"gender":0,"id":6476543,"known_for_department":"Directing","name":"Checha Martinez Gandolfo","original_name":"Checha Martinez Gandolfo","popularity":0,"profile_path":null,"credit_id":"6aa714000164c97144578715","department":"Directing",