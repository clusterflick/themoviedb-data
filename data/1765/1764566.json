{"id":1764566,"retrievedAt":"2026-09-06T14:20:31.590Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"https://agendapropia.co/el-canto-del-maguare","id":1764566,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"El canto del maguaré.","overview":"This short film portrays the words of Dújdulli (Benito Teteye), a wise elder and leader of the Íñeje (Canangucho) Clan of the Bora people. From his maloka in Providencia Nueva, on the banks of the Igaraparaná River in the Colombian Amazon, he guides his community through the ancestral knowledge of sweet cassava, mambe, and ambil. Dújdulli warns of the climate crisis and extractivism that are devastating the mother jungle, disrupting the Amazonian ecological calendar and threatening his people’s food sovereignty. Together with Grandmother María del Pilar Botyay and her son Joatan, they heal the community through songs, dances, and the guidance of the spirits, preserving the memory of a people who survived the rubber boom.","popularity":0.0071,"poster_path":"/ijWUaGkMrjyuykAF7H5VNnFEVcd.jpg","production_companies":[],"production_countries":[],"release_date":"","revenue":0,"runtime":25,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"Palabra de consejo de Dújdulli","title":"El canto del maguaré.","video":true,"vote_average":0,"vote_count":0,"images":{"backdrops":[],"logos":[],"posters":[{"aspect_ratio":0.667,"height":750,"iso_3166_1":null,"iso_639_1":null,"file_path":"/ijWUaGkMrjyuykAF7H5VNnFEVcd.jpg","vote_average":0,"vote_count":0,"width":500}]},"external_ids":{"imdb_id":null,"wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6459491,"known_for_department":"Acting","name":"Dújdulli","original_name":"Dújdulli","popularity":0.0071,"profile_path":null,"cast_id":3,"character":"Self","credit_id":"6a9c93d