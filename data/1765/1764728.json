{"id":1764728,"retrievedAt":"2026-09-06T14:20:42.704Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":27,"name":"Horror"}],"homepage":"","id":1764728,"imdb_id":null,"origin_country":["CL"],"original_language":"en","original_title":"The Walten Files 5 - Faces of Grief","overview":"Tape 5:  \"Rosemary Peony Walten (Born April 20th, 1934) was an artist, filmmaker & composer from Brighton, Michigan. Having studied at the Brighton Public College for Arts, she dedicated her life into making art pieces that would get fairly popular locally. During the 1960s she worked on numerous short films of her own (\"The Dancing Sheep\", \"Crescendo\", amongst many others) and in the 1970s, she joined her husband Jack Walten and friend Felix Kranken in B.S.I. where she'd end up creating and designing the characters that would star in the local burger joint 'Bon's Burgers'. Rose had a loving & caring family of 3 children and a devoted Husband. She was a dedicated member of the Brighton Community Church and hosted numerous charity events alongside her husband, where she donated multiple art pieces. In July 19th, 1974, Rosemary disappeared. She was never found.\"","popularity":0,"poster_path":"/vDJFppXEoebazb0Gaxnth1v6ZbR.jpg","production_companies":[],"production_countries":[],"release_date":"2026-07-31","revenue":0,"runtime":80,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"When she woke up, she looked beautiful.","title":"The Walten Files 5 - Faces of Grief","video":false,"vote_average":10,"vote_count":1,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6459935,"known_for_department":"Writing","name":"Martín Anthony Paredes","original_name":"Martín Anthony Paredes","popularity":0,"profile_path":null,"cast_id":5,"character":"Jack Walten (voice)","credit_id":"6a9cf0b75f23ca0469b799f3","order":0},{"adult":false,"gend