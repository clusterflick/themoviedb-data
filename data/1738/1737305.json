{"id":1737305,"retrievedAt":"2026-07-25T12:23:29.778Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"","id":1737305,"imdb_id":null,"origin_country":["GB"],"original_language":"en","original_title":"Edwin: A dream of White Horses","overview":"A celebration of one of the UK's most impactful climbers: Edwin Drummond. We pay tribute to his life with a look at the historic first ascent of what's now considered to be one of the world's greatest trad multi-pitches 'A Dream Of White Horses'. Located on the spectacular cliffs of Gogarth this ascent was made by Ed Drummond and Dave Pearce in 1968. We bring the ascent to life through reenactment with James Mchaffie and Lex Pearce(Dave's son) accompanied by Ed's poetry which was as big a part of Ed's life as climbing. The two blend together beautifully in this atmospheric tribute to a man who changed the climbing scene forever.","popularity":0.0071,"poster_path":"/wVHYEhc0ehLHqLti5aGDkre3O6s.jpg","production_companies":[{"id":12055,"logo_path":null,"name":"Hot Aches","origin_country":""}],"production_countries":[{"iso_3166_1":"GB","name":"United Kingdom"}],"release_date":"2019-01-01","revenue":0,"runtime":8,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Edwin: A dream of White Horses","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":119915,"known_for_department":"Acting","name":"James McHaffie","original_name":"James McHaffie","popularity":0.4042,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6a63cbff8ff0d1d71823dac5","order":0},{"adult":false,"gender":0,"id":6368115,"known_for_department":"Acting","name":"Lex Pearce","original_name":"Lex Pearce","popularity":0,"profile_path":null,"cast_id":2,"character":"Self","credit_id":"6a63cc124655344c03f979ec","order":1},{"adult":false