{"id":1776658,"retrievedAt":"2026-09-23T15:41:39.363Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1776658,"imdb_id":"tt4351824","origin_country":["US"],"original_language":"en","original_title":"Damocracy","overview":"An environmental documentary film that exposes the myth of large-scale dams as clean energy and a solution to climate change. It highlights the cultural and natural heritage that the world would lose if two planned large-scale dams, Belo Monte dam in Brazil, and Ilisu dam in Turkey, are built. Damocracy is a story of resistance by the thousands of people who will be displaced, and a call to the world to support their struggle. The film focuses on the impact of these dams on the rivers and water systems. It raises awareness on the significance of preserving natural resources and supports the efforts of the people fighting against the construction of dams.","popularity":0.0071,"poster_path":null,"production_companies":[{"id":311812,"logo_path":null,"name":"Doğa Derneği","origin_country":""}],"production_countries":[],"release_date":"2013-04-20","revenue":0,"runtime":35,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"Dams: Destroying Amazonia and Mesopotamia","title":"Damocracy","video":true,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":2918248,"known_for_department":"Directing","name":"Todd Southgate","original_name":"Todd Southgate","popularity":0.2782,"profile_path":null,"cast_id":2,"character":"Narrator","credit_id":"6ab2cfc4aae8b69d5494984b","order":0}],"crew":[{"adult":false,"gender":0,"id":2918248,"known_for_department":"Directing","name":"Todd Southgate","original_name":"Todd Southgate","popularity":0.2782,"profile_path":null,"credit_id":"6ab2cf9553e6b8b4d16cbc1a","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":"tt4351824","wikida