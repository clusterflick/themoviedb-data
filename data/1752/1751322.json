{"id":1751322,"retrievedAt":"2026-08-18T11:51:31.512Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.mntnfilm.com/en/film/climbing-the-jungfrau-1915","id":1751322,"imdb_id":"tt0921850","origin_country":["CH"],"original_language":"en","original_title":"Climbing the Jungfrau","overview":"A record of the ascent of the Jungfrau by Frederick Burlingham accompanied by four mountain guides. The film starts with panoramics of the Eiger North Face from Kleine Scheidegg. The party begin the climb from the Jungfraujoch Station crossing the Jungfrau Firn and reaching the summit of the Jungfrau by the steep Roththal Sattel. Frederick Burlingham was a traveller cinematographer and one of the mountain film pioneers. Continuing the mountain film tradition established by Ormiston-Smith, Burlingham filmed several mountaineering films largely in Switzerland, taking mountain film in a new direction of immediacy and perceived peril. In the early history of factual filmmaking, Burlingham played a substantial role in developing the related genres of the mountaineering and the exploration film.","popularity":0.0071,"poster_path":"/oDyHj4RJY9D3AAbir20a6gr4c1Z.jpg","production_companies":[{"id":132725,"logo_path":null,"name":"Burlingham Travel Pictures","origin_country":""}],"production_countries":[{"iso_3166_1":"CH","name":"Switzerland"}],"release_date":"1915-01-01","revenue":0,"runtime":13,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"","title":"Climbing the Jungfrau","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"GB","title":"Scaling the Jungfrau","type":""},{"iso_3166_1":"DK","title":"Bestigningen af Jomfruen","type":""},{"iso_3166_1":"CH","title":"Die Bezwingung der Jungfrau","type":""}]},"credits":{"cast":[{"adult":false,"gender":2,"id":6418079,