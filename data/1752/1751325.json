{"id":1751325,"retrievedAt":"2026-08-18T11:51:31.600Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.mntnfilm.com/en/film/the-ascent-of-mont-blanc-1915","id":1751325,"imdb_id":null,"origin_country":["CH"],"original_language":"en","original_title":"The Ascent of Mont Blanc","overview":"The ascent of Mont Blanc filmed by Frederick Burlingham in August 1915. A party composed by Burlingham's wife and several guides from Chamonix, climb the Mont Blanc by the normal route of Grands Mulets. Frederick Burlingham was a traveller cinematographer and one of the mountain film pioneers. Continuing the mountain film tradition established by Ormiston-Smith, Burlingham filmed several mountaineering films largely in Switzerland, taking mountain film in a new direction of immediacy and perceived peril. In the early history of factual filmmaking, Burlingham played a substantial role in developing the related genres of the mountaineering and the exploration film.","popularity":0.0071,"poster_path":"/poLIch5Ze00xLZyljVHcOjCKRW0.jpg","production_companies":[{"id":132725,"logo_path":null,"name":"Burlingham Travel Pictures","origin_country":""}],"production_countries":[{"iso_3166_1":"CH","name":"Switzerland"}],"release_date":"1915-08-01","revenue":0,"runtime":12,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"","title":"The Ascent of Mont Blanc","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"CH","title":"Besteigung des Mont-Blanc","type":""}]},"credits":{"cast":[{"adult":false,"gender":0,"id":6418094,"known_for_department":"Acting","name":"Madame Frederick Burlingham","original_name":"Madame Frederick Burlingham","popularity":0,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6a8324de7feaea118410417c","order":0},{"adult":false,"gender":