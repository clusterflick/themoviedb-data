{"id":1751086,"retrievedAt":"2026-08-17T11:48:08.060Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"https://www.mntnfilm.com/en/film/the-ascent-of-mont-blanc-1902","id":1751086,"imdb_id":null,"origin_country":["GB"],"original_language":"en","original_title":"The Ascent of Mont Blanc","overview":"A pioneering mountaineering film made by Frank Ormiston-Smith for the Warwick Trading Company in 1902. Ormiston-Smith himself led and filmed an expedition of seven men up to the top of Mont Blanc. The party left Chamonix the 23rd of september up to Pierre-Pointue and Grands Mulets and reached the top the 25th. The film consists of 18 scenes including a final scene of the team on the summit. This is the first major mountain film shown widely in cinemas. The mountaineering filming is rudimentary by later standards, but in 1902 it gave audiences moving pictures of places, and altitudes, which they could never expect to witness otherwise.","popularity":0,"poster_path":null,"production_companies":[],"production_countries":[],"release_date":"","revenue":0,"runtime":13,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"15.781 feet high","title":"The Ascent of Mont Blanc","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":2,"id":3420885,"known_for_department":"Directing","name":"Frank Ormiston-Smith","original_name":"Frank Ormiston-Smith","popularity":0.4351,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6a8291f17277fc3a78768df1","order":0},{"adult":false,"gender":0,"id":6417070,"known_for_department":"Acting","name":"Christian Bergener","original_name":"Christian Bergener","popularity":0,"profile_path":null,"cast_id":2,"character":"Self","credit_id":"6a8291faec8a6f44a6957bfc","order":1}],"crew":[{"adult":false,"gender":2,"id":3420885,"known_fo