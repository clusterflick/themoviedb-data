{"id":1794703,"retrievedAt":"2026-10-12T20:30:16.688Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1794703,"imdb_id":null,"origin_country":["FR"],"original_language":"fr","original_title":"En Service","overview":"If you need it fixed – if you need it organised – if you don’t know how to do it – if you’re tired of doing it everyday – if you can’t do it alone – if you’ve been wanting to do it for ages – if you’d rather not do it– if it’s plaguing you – if it’s typical of you – if it’s always slipping your mind – if it’s perturbing you, eating at you, consuming you – if it would make you happy – if it suddenly crosses your mind – if it’s right on the tip of your tongue – if you’d like me to do it with you, for you... I will.  The service rendered, for a period of no more than 12 hours, will be documented on video. Don’t delay, make your appointment today. In the event of your unavailability, the said service may be rendered to a third party of your choosing (provided it is not for profit).","popularity":0.0071,"poster_path":"/glp34V37uo3OIQqSwqJ7Bqmo9oD.jpg","production_companies":[{"id":155812,"logo_path":null,"name":"Ostinato Productions","origin_country":""}],"production_countries":[],"release_date":"2007-03-04","revenue":0,"runtime":59,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"En Service","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":1674386,"known_for_department":"Writing","name":"Cyril Brody","original_name":"Cyril Brody","popularity":0.4907,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6acc0b98d4877ad00ce73f78","order":0}],"crew":[{"adult":false,"gender":0,"id":1674386,"known_for_department":"Writing","name":"Cyril Brody","original_name":"Cyril Brody","popularity":0.4907,"profile_path":null,"credit_id":"6acc0bb82f7d2434f