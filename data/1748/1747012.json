{"id":1747012,"retrievedAt":"2026-08-11T12:05:12.654Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1747012,"imdb_id":null,"origin_country":["ES"],"original_language":"es","original_title":"Peligro, no asomarse","overview":"The river Nervión's \"Salto\" at over 200 metres high, is the largest waterfall on the Iberian Peninsula and marks out the course of the river in its first steps after flowing away from its birthplace, forming an immense canyon. A team of motivated highliners have obtained a valuable but limited permit to lay a line across the immense canyon. Used to rigging lines of between 50 and 300 metres, this will be the first time this team has had to rig a line of almost 1 kilometre. A story of companionship and hard work. A formidable team forged among the highline communities of the Basque Country.","popularity":0.0071,"poster_path":"/iMHGElSIVEVA0mxkXj6fcmrQ3S9.jpg","production_companies":[],"production_countries":[{"iso_3166_1":"ES","name":"Spain"}],"release_date":"2024-12-14","revenue":0,"runtime":50,"softcore":false,"spoken_languages":[{"english_name":"Spanish","iso_639_1":"es","name":"Español"},{"english_name":"Basque","iso_639_1":"eu","name":"euskera"}],"status":"Released","tagline":"","title":"Danger Do Not Look Out","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":0,"id":4224371,"known_for_department":"Editing","name":"Daniel Cascales Granados","original_name":"Daniel Cascales Granados","popularity":0.2694,"profile_path":null,"credit_id":"6a7a013c89e195bf5d86ed7e","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":null,"wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"images":{"backdrops":[],"logos":[],"posters":[{"aspect_ratio":0.704,"height":2560,"iso_3166_1":"ES","iso_639_1":"es","file_path":"/iMHGElSIVEVA0mxkX