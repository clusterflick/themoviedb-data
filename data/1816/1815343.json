{"id":1815343,"retrievedAt":"2026-11-03T18:49:08.166Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.craftswomanfilm.com/","id":1815343,"imdb_id":null,"origin_country":["US","FI"],"original_language":"en","original_title":"Craftswoman: Weaving Life Whole","overview":"Craftswoman: Weaving Life Whole is an intimate, \"embodied\" documentary offering a reprieve from our fast-paced and disconnected world. Directed by a filmmaker and textile artist exploring questions about what in our lives gives us a sense of wholeness, the film shifts the focus from the final product to the healing power of “process” itself. Filmed over six months under the pace of trust, the project follows four Finnish craftswomen finding meaning in the rhythm of ancestral craft. Letting go of the typical rush of film production, the filmmaker uses a slow, spacious approach to storytelling—inviting audiences to drop from their analytical minds into their felt senses, and to remember that we already have everything we need to feel whole.","popularity":0.3105,"poster_path":"/4Aobo4o275mfnLWInDMGjzTkkU6.jpg","production_companies":[{"id":316709,"logo_path":null,"name":"Innertidal Creative","origin_country":""}],"production_countries":[{"iso_3166_1":"US","name":"United States of America"},{"iso_3166_1":"FI","name":"Finland"}],"release_date":"2026-10-23","revenue":0,"runtime":83,"softcore":false,"spoken_languages":[{"english_name":"Finnish","iso_639_1":"fi","name":"suomi"},{"english_name":"Swedish","iso_639_1":"sv","name":"svenska"}],"status":"Released","tagline":"","title":"Craftswoman: Weaving Life Whole","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"FI","title":"Naiskäsityöläinen: Elämä Ehjäksi Kutoen","type":""}]},"credits":{"cast":[{"adult":false,"gender":0,"id":6595410,"known_for_department":"Acting","name":"Mervi Pasanen","original_name":"Mervi P