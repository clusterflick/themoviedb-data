{"id":1809409,"retrievedAt":"2026-10-28T17:16:46.177Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"},{"id":35,"name":"Comedy"}],"homepage":"","id":1809409,"imdb_id":null,"origin_country":["MK"],"original_language":"mk","original_title":"По повод Манаки","overview":"A compilation documentary that attempts to reinterpret silent footage by offering an ironic take on Balkan history. This satirical docufiction film showcases the cinematic body of work of the Manaki brothers—the first Balkan cinematographers—spanning the period from 1905 to 1925. It incorporates excerpts from various films, including: *Arrival of a Train at La Ciotat*, *Feeding the Baby*, and *The Sprinkler Sprinkled* by the Lumière brothers (Louis and Auguste); *A Trip to the Moon* by Georges Méliès; wartime newsreels from the German, Austro-Hungarian, and Serbian armies in Macedonia (1914–1918); *Man with a Movie Camera* by Dziga Vertov; *October* by Sergei Eisenstein; *Triumph of the Will* by Leni Riefenstahl; *The Salonika Assassins* by Žika Mitrović; and *Cinema Paradiso* by Giuseppe Tornatore.","popularity":0.0143,"poster_path":null,"production_companies":[{"id":6769,"logo_path":null,"name":"Partysans Film","origin_country":"MK"}],"production_countries":[{"iso_3166_1":"MK","name":"Macedonia"}],"release_date":"","revenue":0,"runtime":41,"softcore":false,"spoken_languages":[{"english_name":"Macedonian","iso_639_1":"mk","name":""}],"status":"Released","tagline":"","title":"On the Occasion of Manaki","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":0,"id":225702,"known_for_department":"Directing","name":"Darko Mitrevski","original_name":"Darko Mitrevski","popularity":0.4605,"profile_path":null,"credit_id":"6ae0a429efdc16ee7aeeb64a","department":"Directing","job":"Director"},{"adult":false,"gender":0,"id":1526007,"known_for_department":"Wri