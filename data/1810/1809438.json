{"id":1809438,"retrievedAt":"2026-10-28T17:16:49.247Z","response":{"adult":false,"backdrop_path":"/34GcUYGie6Zmgxjw4ZkiyJysCPk.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1809438,"imdb_id":null,"origin_country":["FI"],"original_language":"fi","original_title":"Lumppukuningattaret","overview":"Jolanda, a retired archivist, has spent most of his life in the closet. In the late 1970s, he stood on stage alongside his friend Mummo in Finland's first drag show, 'Happy Gays'; the performance was even broadcast on television, and Mummo became one of the first openly gay men in Finland. Then came AIDS, fear and violence. In April 1988, Mummo was murdered in his home; the police were unwilling to solve the case and the entire crime was hushed up. Now, more than thirty years later, Jolanda is opening up his own archive and inviting a new generation of drag artists to bring 'Happy Gays' back to the stage.","popularity":0.05,"poster_path":null,"production_companies":[{"id":159992,"logo_path":null,"name":"Polygraf","origin_country":"FI"},{"id":84295,"logo_path":"/4nHhk4DHGBz5g2DH0h6fAe0lsI1.png","name":"Paloma Productions","origin_country":"DK"}],"production_countries":[{"iso_3166_1":"FI","name":"Finland"},{"iso_3166_1":"DK","name":"Denmark"}],"release_date":"2026-11-07","revenue":0,"runtime":75,"softcore":false,"spoken_languages":[{"english_name":"Finnish","iso_639_1":"fi","name":"suomi"}],"status":"Post Production","tagline":"","title":"Fruitcakes: Dawn of Drag","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6578814,"known_for_department":"Acting","name":"Meeti Assefa","original_name":"Meeti Assefa","popularity":0,"profile_path":null,"cast_id":10,"character":"Self","credit_id":"6ae0a717c20a1eb939eeb60e","order":0},{"adult":false,"gender":0,"id":6489358,"known_for_department":"Acting","name":"Wilma Schlizewski","original_name":"Wilma S