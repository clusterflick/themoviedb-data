{"id":1800873,"retrievedAt":"2026-10-19T17:39:32.563Z","response":{"adult":false,"backdrop_path":"/8EfWHjQpOsx1oKBoH2hY9WzRVvG.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":18,"name":"Drama"},{"id":9648,"name":"Mystery"},{"id":14,"name":"Fantasy"},{"id":878,"name":"Science Fiction"}],"homepage":"","id":1800873,"imdb_id":null,"origin_country":[],"original_language":"en","original_title":"Orphaned Atlas","overview":"TOH, a young man in his twenties, searches for Mak, the woman who raised him and has suddenly disappeared. Accompanied by Ara, an observer newly arrived in his isolated settlement, he enters the forbidden forest, where time begins to fracture. As they move deeper, buried scenes begin to surface: a young man in clothes from another era sits beneath the roots of a tree; a colonial procession passes without seeing them. Toh encounters his own childhood and a younger Mak moving through the same landscape. As these fragments gather, he begins to understand that the only home he has known, was shaped by a long-running experiment in forgetting, while Ara is drawn toward a disappearance buried in her own past.","popularity":0.0286,"poster_path":null,"production_companies":[{"id":95385,"logo_path":"/1eKqp1eCQHTivYxYM0ny1AeCTAM.png","name":"Forka Films","origin_country":"ID"},{"id":89839,"logo_path":"/ow9FiFejtLYJzYGvkvt7MWyI6RJ.png","name":"Pili Films","origin_country":"FR"},{"id":214435,"logo_path":null,"name":"TAK Studioworks","origin_country":""}],"production_countries":[{"iso_3166_1":"ID","name":"Indonesia"},{"iso_3166_1":"FR","name":"France"},{"iso_3166_1":"NL","name":"Netherlands"}],"release_date":"","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[],"status":"In Production","tagline":"","title":"Sampar","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":2,"id":3991958,"known_for_department":"Directing","name":"Timoteus Anggawan Kusno","original_name"