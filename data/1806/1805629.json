{"id":1805629,"retrievedAt":"2026-10-24T14:39:19.432Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"","id":1805629,"imdb_id":"tt0353812","origin_country":["US"],"original_language":"en","original_title":"No Soup","overview":"The American Consul is stationed away off among the Igorottes, and leads a most lonely existence. He pines for the sight of an American, and especially so for one of the fair sex. The day the minister and his wife land, they try to help the poor savages to a better way of living and are spied by the ever alert consul; the minister's daughter especially being noticed. He meets them and offers the hospitality of his house. The girl is also accompanied by her small dog. The consul is entertaining his visitors, when the girl's dog breaks away. As soon as the dog is missed, there is consternation, for the \"dog-eating\" habits of the Igorottes are well known and the consul leads the search. They go to the butcher's, where there is quite a collection of dogs, and make a thorough search but all in vain. He tells them that he has not seen anything of the dog.","popularity":0.0071,"poster_path":null,"production_companies":[],"production_countries":[],"release_date":"","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"No Soup","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":2,"id":1422194,"known_for_department":"Acting","name":"Ernest Shields","original_name":"Ernest Shields","popularity":0.7263,"profile_path":"/iSOMVMqU9N07Jyam1skxQsxlMxT.jpg","cast_id":2,"character":"The American Consul","credit_id":"6adbb5bb484961a62a16c72c","order":0},{"adult":false,"gender":2,"id":9095,"known_for_department":"Acting","name":"Eddie Boland","original_name":"Eddie Boland","popularity":0.6964,"profile_path":"/2x8C7aH1r0CAtZMbuSBa2DuZsGO.jpg","cast_id":3,"character":"The Butcher","credit_id":"6adbb5c746213384d00170c3","order":1},{"adult":false,"gender":1,"id":2267303,"known_for_department":"Acting","name":"Jane Bernoudy","original_name":"Jane Bernoudy","popularity":0.501,"profile_path":null,"cast_id":4,"character":"The Butcher's Wife","credit_id":"6adbb5d437917450550170c4","order":2},{"adult":false,"gender":0,"id":2886388,"known_for_department":"Acting","name":"Walter Bytell","original_name":"Walter Bytell","popularity":0.4516,"profile_path":null,"cast_id":5,"character":"The Missionary","credit_id":"6adbb5e4ff4703250a207a2e","order":3},{"adult":false,"gender":0,"id":5485177,"known_for_department":"Acting","name":"Queenie Rosson","original_name":"Queenie Rosson","popularity":0.5074,"profile_path":null,"cast_id":6,"character":"The Missionary's Daughter","credit_id":"6adbb5f1a15700026f0170d0","order":4}],"crew":[{"adult":false,"gender":0,"id":6571157,"known_for_department":"Directing","name":"Roy McCray","original_name":"Roy McCray","popularity":0,"profile_path":null,"credit_id":"6adbb5aa0bf902ea0f21c557","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":"tt0353812","wikidata_id":null,"facebook_id":null,"instagram_id":null,"twitter_id":null},"images":{"backdrops":[],"logos":[],"posters":[]},"keywords":{"keywords":[]},"release_dates":{"results":[]},"videos":{"results":[]}}}