{"id":1804597,"retrievedAt":"2026-10-23T16:02:20.255Z","response":{"adult":false,"backdrop_path":"/jqb4k3Ek9eN4VZZgfZCxVmKzhp3.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1804597,"imdb_id":null,"origin_country":["MX"],"original_language":"es","original_title":"Anti-Princesas","overview":"At the Neza-Bordo prison, ten incarcerated women take part in a theater workshop led by La Cana. Through rehearsals, the stage becomes a space to name violence, revisit their own stories and recover a voice that was silenced for years.  Anti-Princesas follows this process up to the final performance in front of their families, interweaving the theater work with the participants' testimonies. Their accounts reveal stories marked by gender-based violence, abusive relationships, long periods without a sentence, and a justice system that often fails to effectively apply the gender perspective set out in Mexican law.  More than a film about prison, Anti-Princesas is a collective portrait of ten women who, from confinement, find in theater a form of resistance, expression and freedom.","popularity":0.0143,"poster_path":"/nS5qUyuyDRBaiYdVNPnYLlu1JPl.jpg","production_companies":[{"id":182171,"logo_path":"/qQh8Lki1EckLMJZd5lJJfuPto4K.png","name":"BHD Films","origin_country":"MX"}],"production_countries":[{"iso_3166_1":"MX","name":"Mexico"}],"release_date":"2026-10-20","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[{"english_name":"Spanish","iso_639_1":"es","name":"Español"}],"status":"Released","tagline":"","title":"Anti-Princesas","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6568933,"known_for_department":"Acting","name":"Cynthia Berenice Vilchis Camarena","original_name":"Cynthia Berenice Vilchis Camarena","popularity":0,"profile_path":null,"cast_id":34,"character":"Self","credit_id":"6ada8707b49e0b6af231ffe0","order":0},{"adult":