{"id":1804575,"retrievedAt":"2026-10-23T16:02:17.830Z","response":{"adult":false,"backdrop_path":"/i01CuL045aQhaqh605MYcp1lkeO.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.mntnfilm.com/en/film/klettern-1943","id":1804575,"imdb_id":null,"origin_country":["CH"],"original_language":"de","original_title":"Klettern","overview":"Documentary film of the Swiss newsreel about climbing in the Kreuzbergen. The film was produced in August 1943 by the Zurich company Gloria Film AG. The camera was directed by none other than Otto Ritter (1917-1977), whose work can be admired in well-known Swiss feature films such as ´Romeo and Julia on Dorf´ . The focus is on the two climbers Beni Motzer and Ernst Anderegg, who demonstrate the ascent of the 5th Kreuzberg. Didactic sequences show the current climbing equipment of that time and how to handle it correctly. The film premiered at the Olma in 1943 and was shown in Swiss cinemas from May 1944 as part of the weekly film show. Because of his spectacular shots he enthused the critics and was very well received by the audience.","popularity":0.0143,"poster_path":"/ieBtsvEBBF28idUBTjvHJohILQk.jpg","production_companies":[{"id":18452,"logo_path":null,"name":"Gloriafilm AG","origin_country":""}],"production_countries":[{"iso_3166_1":"CH","name":"Switzerland"}],"release_date":"1943-08-01","revenue":0,"runtime":0,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"Climbing","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"CH","title":"Gipfelstürmer in den Kreuzbergen","type":""}]},"credits":{"cast":[{"adult":false,"gender":2,"id":6568815,"known_for_department":"Acting","name":"Beni Motzer","original_name":"Beni Motzer","popularity":0.0071,"profile_path":null,"cast_id":1,"character":"self","credit_id":"6ada78584ee2daf0a640432f","order":0},{"adult":false,"gender":2,"id":6568816,"known_for_department":"Acting","