{"id":1741472,"retrievedAt":"2026-08-02T12:24:42.271Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":6700,"genres":[{"id":18,"name":"Drama"}],"homepage":"","id":1741472,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"Transit","overview":"Transit is an evocative, genre-bending exploration of migration and what it means to find a place to call home. Told through a series of vignettes utilising physical theatre, poetry, dance, multimedia, practical lights and live music, Transit follows a cast of contemporary migrants as they navigate the feeling of being ‘too foreign for here, too foreign for home.’  This deeply human piece is a love letter to everyone who has ever lived in between where you came from and where you are now, whether that be 5 or 5,000 miles away.  Studio Holder is delighted to be collaborating with Halfpace Theatre, in the production of a not-for-profit feature-length film of Transit, the film of which is bound for festivals from Autumn 2026.","popularity":0.0143,"poster_path":null,"production_companies":[{"id":179892,"logo_path":null,"name":"Studio Holder","origin_country":""}],"production_countries":[],"release_date":"2026-12-01","revenue":0,"runtime":80,"softcore":false,"spoken_languages":[],"status":"In Production","tagline":"How do you pack a life into 23 kilograms? One item at a time.","title":"Transit","video":true,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6383408,"known_for_department":"Acting","name":"Ting-Ning Wen","original_name":"Ting-Ning Wen","popularity":0,"profile_path":null,"cast_id":1,"character":"Ensemble","credit_id":"6a6df9e5489393f82f246b85","order":0},{"adult":false,"gender":0,"id":6383409,"known_for_department":"Acting","name":"Bethany Monk-Lane","original_name":"Bethany Monk-Lane","popularity":0,"profile_path":null,"cast_id":2,"character":"Ensemble","credit_id":"6a6df9ef9d904613e1e5