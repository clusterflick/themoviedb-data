{"id":1769321,"retrievedAt":"2026-09-13T15:10:04.102Z","response":{"adult":false,"backdrop_path":"/iuoJPwA9ANt7Eya7EmbdxbZ0Q7v.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.mntnfilm.com/en/film/a-la-conquete-des-cimes-1927","id":1769321,"imdb_id":null,"origin_country":["FR"],"original_language":"fr","original_title":"A la conquête des cimes","overview":"Hermann Perren, mountain guide, prepares the ascent of Dent du Requin with a companion. He checks the equipment necessary for any mountaineer, rope, ice axe, glasses, double socks and iron shoes. They leave Chamonix, cross the Mer de Glace and arrive at the Requin Refuge. The next morning, Perren and his companion cross the glacier and encounter huge crevasses and seracs, which slow their progress. They cautiously cross a snow bridge and bivouac a few hours later. The climb is more and more difficult. They reach the Requin shoulder and have to climb the vertical wall to the summit. A shortened and sounded version of the film was released in 1937 under the same title by Les Films du Sagittaire.","popularity":0.0143,"poster_path":"/tgMJRkj5vw2GJhsj2ECJAbUvR7u.jpg","production_companies":[{"id":80925,"logo_path":null,"name":"Compagnie Générale Cinématographique (CGC)","origin_country":"FR"}],"production_countries":[{"iso_3166_1":"FR","name":"France"}],"release_date":"1927-01-01","revenue":0,"runtime":50,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"","title":"A la conquête des cimes","video":false,"vote_average":0,"vote_count":0,"credits":{"cast":[{"adult":false,"gender":2,"id":6419136,"known_for_department":"Acting","name":"Hermann Perren","original_name":"Hermann Perren","popularity":0.2888,"profile_path":"/xv6yBSOHpR8uvldxEEfgwtc5GCH.jpg","cast_id":1,"character":"Self","credit_id":"6aa5be4012b56095cdc16f38","order":0}],"crew":[{"adult":false,"gender":2,"id":31742