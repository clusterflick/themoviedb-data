{"id":1838896,"retrievedAt":"2026-11-23T22:51:21.310Z","response":{"adult":false,"backdrop_path":"/wZZqSjVXHDKo1UM4CgOZ65Q1Skf.jpg","belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1838896,"imdb_id":null,"origin_country":["CH","XK"],"original_language":"en","original_title":"i would(n't) go back","overview":"A documentary tracing the restructuring of family constellations in Kosova during the transition from socialism to post-socialism - from bashkësi as a form of extended household rooted in collective property relations and social reproduction, to the nuclear family under emerging capitalist social formations.  The film brings together archival material, personal reflections, conversations, and historical research while making the process of filmmaking and editing visible to invite the viewer to remain attentive to how histories and narratives are constructed.  Across its chapters, the visuals evoke states of calmness, overwhelm, and anxiety, reflecting the lived experience of these transformations. Through remaining intentionally raw and unresolved, the film embraces fragmentation and collective ways of thinking, asking how memory, belonging, and consciousness continue to be negotiated across generations.","popularity":0.0582,"poster_path":"/8DK8iDMaA1wSasHOzVmlcUnzSpl.jpg","production_companies":[{"id":75732,"logo_path":null,"name":"Zürcher Hochschule der Künste","origin_country":"CH"}],"production_countries":[{"iso_3166_1":"CH","name":"Switzerland"}],"release_date":"2026-06-26","revenue":0,"runtime":87,"softcore":false,"spoken_languages":[{"english_name":"Albanian","iso_639_1":"sq","name":"shqip"},{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"i would(n't) go back","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":0,"id":6691669,"known_for_department":"Acting","name":"Erzana Idriza