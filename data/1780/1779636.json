{"id":1779636,"retrievedAt":"2026-09-25T16:12:07.453Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"},{"id":10402,"name":"Music"}],"homepage":"","id":1779636,"imdb_id":"tt39388578","origin_country":["GR"],"original_language":"el","original_title":"Hip Hop Mediterraneo","overview":"\"Hip Hop Mediterraneo\" follows Social Waste, an independent music collective that has been carving its own path outside the conventions of the music industry for 25 years. Its members, scattered across different parts of Greece, reunite to create their new album and hit the road once again. Through personal moments, conflicts and archival material, the film reveals both the strength and the difficulties of collectivity. With sharp political and social commentary, Social Waste merges hip hop with the musical traditions of the Mediterranean. A musical road movie about co-existence, freedom and the power of togetherness.","popularity":0,"poster_path":"/6USfAOnOqJrzTkl8SZ4QAptB2bE.jpg","production_companies":[],"production_countries":[{"iso_3166_1":"GR","name":"Greece"}],"release_date":"2026-10-06","revenue":0,"runtime":75,"softcore":false,"spoken_languages":[{"english_name":"Greek","iso_639_1":"el","name":"ελληνικά"}],"status":"Post Production","tagline":"","title":"Hip Hop Mediterraneo","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":0,"id":2783362,"known_for_department":"Crew","name":"Alfonso De Munno Gallardo","original_name":"Alfonso De Munno Gallardo","popularity":0.25,"profile_path":null,"credit_id":"6ab5edd3dca84e9c82a81f46","department":"Directing","job":"Director"},{"adult":false,"gender":0,"id":2783362,"known_for_department":"Crew","name":"Alfonso De Munno Gallardo","original_name":"Alfonso De Munno Gallardo","popularity":0.25,"profile_path":null,"credit_id":"6ab5edde55bce84e6e48e591","department":"Writing","job":"Wr