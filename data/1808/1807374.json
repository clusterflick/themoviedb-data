{"id":1807374,"retrievedAt":"2026-10-26T17:42:43.856Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"},{"id":36,"name":"History"}],"homepage":"","id":1807374,"imdb_id":null,"origin_country":["US"],"original_language":"en","original_title":"Big Jim: An American on Everest","overview":"“Big Jim” Whittaker (1929-2026) was a legendary Pacific Northwest mountaineer who became the first American to summit Mount Everest on May 1, 1963. This short documentary explores his “brotherhood of the rope” with his twin brother, Lou, as well as Nawang Gombu Sherpa, his Everest climbing partner and lifelong friend. Featuring rarely seen 16mm footage from the 1963 Everest Expedition, archival images from the Whittaker family collection, and interviews filmed in Jim’s late 80s, the film is both an intimate portrait of an extraordinary life and a celebration of the adventurous spirit that helped define a generation of climbers.","popularity":0.0571,"poster_path":"/fAkNYBHpNsRcGFf6O8NysAKjg0E.jpg","production_companies":[],"production_countries":[],"release_date":"2026-11-20","revenue":0,"runtime":9,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"Big Jim: An American on Everest","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":2,"id":1641750,"known_for_department":"Acting","name":"Jim Whittaker","original_name":"Jim Whittaker","popularity":0.5677,"profile_path":"/jDvvczA4LqliMxrHfFPwvvuHQ4m.jpg","cast_id":2,"character":"Self (archive footage)","credit_id":"6ade24bf6b432e5fe5865a5c","order":0}],"crew":[{"adult":false,"gender":2,"id":1641740,"known_for_department":"Directing","name":"Jim Aikman","original_name":"Jim Aikman","popularity":0.3094,"profile_path":"/eMv0qAjl1JJEyiKTrSlPTK2g2nx.jpg","credit_id":"6ade24643031dfa461e1cfc2","department":"Directing","job":"Director"}]},"external_ids":{"imdb_id":null