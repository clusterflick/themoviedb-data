{"id":1807231,"retrievedAt":"2026-10-26T17:42:31.578Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1807231,"imdb_id":"tt0850717","origin_country":["US"],"original_language":"en","original_title":"Too Colourful for the League","overview":"Too Colourful For The League is a made-for-TV documentary examining the struggle of blacks in hockey from the 30's to the present day and the campaign to have Herb Carnegie elected into the Hall of Fame. Carnegie was a black superstar in the 40's and 50's who never played in the NHL because of the league's unacknowledged color bar. Maple Leafs owner Conn Smythe once saw Carnegie play and said, \"I'd give $10,000 to turn that boy white.\" The campaign is supported by Hockey hall of Famers Jean Beliveau and Red Storey, among others. In Cinema Verité style, the documentary tells the story of black players' courage and determination to play in a white-dominated sport.","popularity":0.0214,"poster_path":null,"production_companies":[],"production_countries":[],"release_date":"","revenue":0,"runtime":52,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"Too Colourful for the League","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":2,"id":90716,"known_for_department":"Production","name":"Daniel Cross","original_name":"Daniel Cross","popularity":0.6983,"profile_path":"/fTn02qt67eL0bI9dVfdvgntLWwa.jpg","credit_id":"6addf981daf109f1c55774a5","department":"Directing","job":"Director"},{"adult":false,"gender":0,"id":1452072,"known_for_department":"Directing","name":"Mila Aung-Thwin","original_name":"Mila Aung-Thwin","popularity":0.6592,"profile_path":null,"credit_id":"6addf9901c3ed3bac1d82ba5","department":"Directing","job":"Director"},{"adult":false,"gender":0,"id":6574395,"known_for_department":"Writing","name":"Max Wallace","or