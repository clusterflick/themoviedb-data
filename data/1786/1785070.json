{"id":1785070,"retrievedAt":"2026-10-01T17:40:28.198Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.mntnfilm.com/en/film/liesels-schoenste-kletterfahrt-1938","id":1785070,"imdb_id":null,"origin_country":["DE"],"original_language":"de","original_title":"Liesels schönste Kletterfahrt","overview":"The film is presented as a climbing film from Tirol's mountain world based on an idea by Kurt Maix, and it's a touristical film of the series 'Bilder aus Österreich' (Pictures of Austria). A man and a woman leave the city to go to the mountains of the Austrian Tirol to make some rock climbing. They spend one night at a mountain hut and next morning they walk up to the base of the wall and start climbing. The couple, with the man always leading, overcome a series of difficult passages and reach the summit. There they sign in the book of ascents with the names of Peter Martin and Lial, and start the descent doing several rappels.","popularity":0.0071,"poster_path":"/s68feMqZCbF3rDXk4XAWPuEoHMi.jpg","production_companies":[{"id":312738,"logo_path":null,"name":"Reichsbahnzentrale für den Deutschen Reiseverkehr","origin_country":"DE"}],"production_countries":[{"iso_3166_1":"DE","name":"Germany"}],"release_date":"1938-01-01","revenue":0,"runtime":15,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"","title":"Liesels schönste Kletterfahrt","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"XC","title":"Horolezectví v Alpách","type":"Czech"},{"iso_3166_1":"SU","title":"Лучшая Лизина поездка в горы","type":"Russian"}]},"credits":{"cast":[{"adult":false,"gender":2,"id":6516497,"known_for_department":"Acting","name":"Peter Martin","original_name":"Peter Martin","popularity":0.0071,"profile_path":null,"cast_id":1,"character":"Self","credit_id":"6abd4a80