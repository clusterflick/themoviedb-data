{"id":1771358,"retrievedAt":"2026-09-16T15:42:04.483Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":18,"name":"Drama"},{"id":12,"name":"Adventure"}],"homepage":"https://www.mntnfilm.com/en/film/the-glacier-s-secret-1930","id":1771358,"imdb_id":"tt45114286","origin_country":["US"],"original_language":"en","original_title":"The Glacier's Secret","overview":"\"In this film of the 'Vagabond Adventure Series', Tom Terris takes us to New Zealand in a kind of travelogue film. We accompany a client and a mountain guide on a treacherous, icy trek across a glacier. At night they camp and the old man tells him how he lost his love in an accident fourty years ago during their honeymoon. In the morning the old man has disappeared, but client finally finds him in a cave admiring the body of his frozen lover, captured on ice. The film conveys a feeling that is rarely identified with travel films, and contains a tender, tragic note that is genuinely touching.\"","popularity":0.0071,"poster_path":"/a9dOPNFFVqL2shjXR50Hf1puMRd.jpg","production_companies":[{"id":7515,"logo_path":null,"name":"Van Beuren Studios","origin_country":"US"},{"id":187790,"logo_path":null,"name":"Van Beuren Corporation","origin_country":""},{"id":250694,"logo_path":null,"name":"The Van Beuren Corporation","origin_country":""}],"production_countries":[{"iso_3166_1":"US","name":"United States of America"}],"release_date":"1930-01-01","revenue":0,"runtime":10,"softcore":false,"spoken_languages":[{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"The Glacier's Secret","video":false,"vote_average":0,"vote_count":0,"credits":{"cast":[{"adult":false,"gender":2,"id":148067,"known_for_department":"Writing","name":"Tom Terriss","original_name":"Tom Terriss","popularity":0.5943,"profile_path":"/jUDuJf578pkk4a5QrxaNL2ZsAP2.jpg","cast_id":1,"character":"Narrator (as Tom Terriss)","credit_id":"6aa9d94f24f3de67e240c