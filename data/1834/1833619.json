{"id":1833619,"retrievedAt":"2026-11-21T18:20:26.788Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"","id":1833619,"imdb_id":null,"origin_country":["US","FR"],"original_language":"en","original_title":"Fabric","overview":"FABRIC pulls back the curtain on the world of French haute couture, spotlighting refugee artisans whose meticulous craftsmanship brings high fashion to life. With exclusive access to the Espero Atelier - a workshop that trains refugees in haute couture tailoring and places them in top fashion houses - this documentary follows several trainees who have made Paris their home and found purpose and pride in preserving centuries-old artisanal techniques. Through intimate interviews at home, moments in the workshop and an exciting fashion show at the prestigious Musee d’Orsay, FABRIC explores the intersection of heritage, identity and savoir-faire. We learn how these unsung heroes navigate cultural integration. Their stories reveal not only the craftsmanship behind couture but also the human stories woven into every stitch.","popularity":0.0194,"poster_path":"/oXCgBiR5tAEvY6ebAP8jAzMdyT.jpg","production_companies":[{"id":320820,"logo_path":null,"name":"Hemeroscope Studios","origin_country":""},{"id":320821,"logo_path":null,"name":"Tiny Circus Productions","origin_country":""}],"production_countries":[],"release_date":"","revenue":0,"runtime":23,"softcore":false,"spoken_languages":[{"english_name":"French","iso_639_1":"fr","name":"Français"},{"english_name":"English","iso_639_1":"en","name":"English"}],"status":"Released","tagline":"","title":"Fabric","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":0,"id":2279181,"known_for_department":"Production","name":"Anabelle Marshall","original_name":"Anabelle Marshall","popularity":0.0911,"profile_path":null,"credit_id":"6b00c9054771b9