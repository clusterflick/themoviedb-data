{"id":1843266,"retrievedAt":"2026-11-25T20:46:20.122Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"","id":1843266,"imdb_id":null,"origin_country":["FR"],"original_language":"fr","original_title":"Le Monde normal","overview":"\"I grew up in a hospital in eastern France that was inaugurated in 1973 by my parents, both of whom were psychiatrists. Breaking with the tradition of asylums, they experimented with new ways of providing care. Today, that hospital has changed: walls have gone up and doors have closed. By bringing together the perspectives of those who lived there and those who still do—children, adults, doctors, and patients—I return to the site to revive the medical utopia of the 1970s and contrast it with the reality of today’s hospital.\"  -Hélène Risser","popularity":0.0194,"poster_path":"/d0juuQxcgRyniVkSUAd4M68fwWH.jpg","production_companies":[{"id":107792,"logo_path":"/3c6UduemVcjkqX5SQhDvsH1IBGo.png","name":"La Clairière Production","origin_country":"FR"}],"production_countries":[{"iso_3166_1":"FR","name":"France"}],"release_date":"2019-01-01","revenue":0,"runtime":52,"softcore":false,"spoken_languages":[{"english_name":"French","iso_639_1":"fr","name":"français"}],"status":"Released","tagline":"","title":"Le Monde normal","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[],"crew":[{"adult":false,"gender":1,"id":2107853,"known_for_department":"Directing","name":"Hélène Risser","original_name":"Hélène Risser","popularity":0.0603,"profile_path":"/y7NR9vKSEWlJGCkL8nfd50LO4nb.jpg","credit_id":"6b0618818e33a3c13df992bb","department":"Directing","job":"Director"},{"adult":false,"gender":1,"id":2107853,"known_for_department":"Directing","name":"Hélène Risser","original_name":"Hélène Risser","popularity":0.0603,"profile_path":"/y7NR9vKSEWlJGCkL8nfd50LO4nb.jpg","credit_id":"6b06188c450eba9d94787ddb","department":"Writing","job":"Writer"},{"adult"