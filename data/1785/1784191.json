{"id":1784191,"retrievedAt":"2026-09-30T17:03:35.082Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[{"id":99,"name":"Documentary"}],"homepage":"https://www.mntnfilm.com/en/film/scuola-di-roccia-1938","id":1784191,"imdb_id":null,"origin_country":["IT"],"original_language":"it","original_title":"Scuola di roccia","overview":"An exceptional cinematographic document on Emilio Comici, shot in 1938 in Val Rosandra by a MGM operator. The documentary shows Comici with the mountain guide Gianni Macor, in all the stages of the rock climbing technique, in the way of an instructional film. Comici, nicknamed the 'Angel of the Dolomites', is considered as the most extraordinary climber of the period between the two World Wars. He made over 200 first ascents in the Dolomites during his short career. Comici perfected the Bavarian technique of mountain climbing, and began the era of 'sixth grade' climbing. It was Comici who originated the concept of climbing direttissima routes, following the path a drop of water would take down the mountain.","popularity":0.0071,"poster_path":"/7IedEncNiLLtQkCs63RYb3YVXJf.jpg","production_companies":[{"id":312656,"logo_path":null,"name":"Julia Film Trieste","origin_country":"IT"},{"id":312657,"logo_path":null,"name":"CIne-GUF","origin_country":""}],"production_countries":[{"iso_3166_1":"IT","name":"Italy"}],"release_date":"1938-01-01","revenue":0,"runtime":23,"softcore":false,"spoken_languages":[{"english_name":"No Language","iso_639_1":"xx","name":"No Language"}],"status":"Released","tagline":"Con saggi del grande rocciatore Emilio Comici","title":"Scuola di roccia","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[{"iso_3166_1":"IT","title":"Emilio Comici in arrampicata","type":""}]},"credits":{"cast":[{"adult":false,"gender":2,"id":5995592,"known_for_department":"Acting","name":"Emilio Comici","original_name":"Emilio Comici","popularity":0.2914,"profile_path":"/7yc7O