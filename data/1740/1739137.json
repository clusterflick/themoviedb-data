{"id":1739137,"retrievedAt":"2026-07-28T13:14:59.123Z","response":{"adult":false,"backdrop_path":null,"belongs_to_collection":null,"budget":0,"genres":[],"homepage":"","id":1739137,"imdb_id":null,"origin_country":["PE"],"original_language":"es","original_title":"La chicha está fermentando","overview":"A nearly forgotten Peruvian film, \"La Chicha está Fermentando\" (1983), produced by Lucho Llosa. Haydée Cáceres, Ramón García, Jesús Morales, \"Eleuterio,\" \"La Juanacha,\" Hugo Loza, young actors, and the indigenous man Mayta singing, all starred together in this Peruvian film that, for some reason, doesn't appear in the historical records of Peruvian cinema. It never reached theaters. It was only broadcast on television... and then disappeared. As if it had never existed. It's a forgotten, overlooked film, remembered by few. But today it has been rescued.","popularity":0,"poster_path":null,"production_companies":[],"production_countries":[{"iso_3166_1":"PE","name":"Peru"}],"release_date":"1983-01-01","revenue":0,"runtime":74,"softcore":false,"spoken_languages":[],"status":"Released","tagline":"","title":"La chicha está fermentando","video":false,"vote_average":0,"vote_count":0,"alternative_titles":{"titles":[]},"credits":{"cast":[{"adult":false,"gender":2,"id":1085312,"known_for_department":"Acting","name":"Ramón García","original_name":"Ramón García","popularity":0.2888,"profile_path":"/ridDQMfFdTZ936ALAF6J8B70HO4.jpg","cast_id":2,"character":"","credit_id":"6a68139d6111900e4a146e89","order":0},{"adult":false,"gender":0,"id":145791,"known_for_department":"Acting","name":"Víctor Prada","original_name":"Víctor Prada","popularity":0.3358,"profile_path":"/17w3FIJVwjd3jGAbM2x8KCE4qZd.jpg","cast_id":3,"character":"","credit_id":"6a6813a4a55768ef4f0ffc2a","order":1},{"adult":false,"gender":1,"id":1987508,"known_for_department":"Acting","name":"Haydeé Cáceres","original_name":"Haydeé Cáceres","popularity":0.4437,"profile_path":"/boRwAhbUcAdUflM55my1PxFR0EN.jpg","cast_id":